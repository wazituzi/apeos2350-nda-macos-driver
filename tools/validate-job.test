# Validate-Job attribute probe: never prints, only asks "would you accept this?".
{
    NAME "Validate job attributes"
    OPERATION Validate-Job
    GROUP operation-attributes-tag
    ATTR charset attributes-charset utf-8
    ATTR language attributes-natural-language en
    ATTR uri printer-uri $uri
    ATTR name requesting-user-name probe
    ATTR mimeMediaType document-format image/urf
    ATTR name job-name "attribute probe - not a real job"
    ATTR keyword media $media
    ATTR keyword sides $sides
    ATTR keyword print-color-mode $mode
    ATTR resolution printer-resolution $res
    STATUS successful-ok
}
