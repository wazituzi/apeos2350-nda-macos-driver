# Ask the device about one specific job.
{
    NAME "Get job 1 attributes"
    OPERATION Get-Job-Attributes
    GROUP operation-attributes-tag
    ATTR charset attributes-charset utf-8
    ATTR language attributes-natural-language en
    ATTR uri printer-uri $uri
    ATTR uri job-uri ipp://192.168.1.100:631/ipp/print/job-1
    ATTR integer job-id 1
    ATTR name requesting-user-name probe
    STATUS successful-ok
    DISPLAY job-id
    DISPLAY job-uri
    DISPLAY job-name
    DISPLAY job-state
    DISPLAY job-state-reasons
    DISPLAY job-impressions-completed
    DISPLAY document-format
    DISPLAY job-originating-user-name
    DISPLAY time-at-creation
    DISPLAY time-at-processing
    DISPLAY time-at-completed
}
